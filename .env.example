# web
GITHUB_WEBHOOK_SECRET=
DATABASE_URL=postgres://enac_ai:enac_ai@localhost:5432/enac_ai_reviewer
ALLOWED_ORGANIZATIONS=EPFL-ENAC
GITHUB_BOT_LOGIN=enac-ai-reviewer
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
PORT=3000
# Admin UI auth mode: "proxy" (organisation auth proxy) or "keycloak" (direct OIDC)
ADMIN_AUTH_MODE=proxy
ADMIN_AUTH_ENABLED=true
# Proxy mode settings (ignored when ADMIN_AUTH_MODE=keycloak)
ADMIN_AUTH_HEADER_USER=X-Auth-Request-User
ADMIN_AUTH_HEADER_EMAIL=X-Auth-Request-Email
# Optional comma-separated allowlist; leave empty to allow any authenticated user
ADMIN_AUTH_USERS=
# Keycloak direct OIDC settings (ignored when ADMIN_AUTH_MODE=proxy)
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=my-realm
KEYCLOAK_CLIENT_ID=enac-ai-reviewer
KEYCLOAK_CLIENT_SECRET=
# Full URL of the OIDC callback endpoint; defaults to ${KEYCLOAK_URL}/admin/auth/callback
KEYCLOAK_REDIRECT_URI=
# Secret for encrypting the browser session (required for Keycloak mode, min 32 chars)
SESSION_SECRET=
TRUST_PROXY=false

# worker (additional, on top of the above)
LLM_BASE_URL=https://inference.rcp.epfl.ch/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.6-35B-A3B

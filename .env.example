# web
GITHUB_WEBHOOK_SECRET=
DATABASE_URL=postgres://enac_ai:enac_ai@localhost:5432/enac_ai_reviewer
ALLOWED_ORGANIZATIONS=EPFL-ENAC
GITHUB_BOT_LOGIN=enac-ai-reviewer
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
PORT=3000
# Admin UI auth (handled by the organisation proxy, e.g. Keycloak/OAuth2 Proxy)
ADMIN_AUTH_ENABLED=true
ADMIN_AUTH_HEADER_USER=X-Auth-Request-User
ADMIN_AUTH_HEADER_EMAIL=X-Auth-Request-Email
# Optional comma-separated allowlist; leave empty to allow any authenticated user
ADMIN_AUTH_USERS=
TRUST_PROXY=false

# worker (additional, on top of the above)
LLM_BASE_URL=https://inference.rcp.epfl.ch/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.6-35B-A3B

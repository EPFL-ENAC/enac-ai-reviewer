{
  "name": "enac-ai-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:web": "node dist/web/server.js",
    "start:worker": "node dist/worker/worker.js",
    "dev:web": "tsx watch src/web/server.ts",
    "dev:worker": "tsx watch src/worker/worker.ts",
    "migrate": "node-pg-migrate -m src/db/migrations -j sql",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^0.1.0",
    "@octokit/app": "^15.0.0",
    "@octokit/rest": "^21.0.0",
    "ai": "^4.0.0",
    "fastify": "^5.1.0",
    "node-pg-migrate": "^7.9.1",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
